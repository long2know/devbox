# ./setup.sh creates a private .env with a random password and your Linux UID/GID.
# For manual setup, copy this file to .env, chmod 600, and edit those values.
COMPOSE_PROJECT_NAME=devbox
DEVBOX_IMAGE=devbox-cinnamon:latest
DEVBOX_CONTAINER_NAME=devbox
# Relative paths are resolved from this checkout. Use a private path on the host.
DEVBOX_DATA_DIR=./data
PUID=1000
PGID=1000
TZ=Etc/UTC

# Browser login; the Linux desktop account is always abc.
# The same password is set for abc's sudo access.
DESKTOP_USER=developer
# Single-quote passwords containing $ so Compose preserves them literally.
DESKTOP_PASSWORD=
DESKTOP_BIND_ADDRESS=127.0.0.1
# One published host port; HTTPS is required for direct LAN browser access.
DESKTOP_PORT=4200
# 3001 = direct HTTPS; 3000 = HTTP only behind an HTTPS reverse proxy.
DESKTOP_BACKEND_PORT=3001
DESKTOP_TITLE=devbox
# Must begin and end with /; e.g. /devbox/ when using nginx/location.conf.
BASE_PATH=/

# Optional CLI authentication instead of interactive OAuth. Leave blank normally.
# Use a suitable GitHub CLI token and a Copilot-enabled fine-grained token.
# Copilot requires the "Copilot Requests" permission; classic PATs are unsupported.
GH_TOKEN=
COPILOT_GITHUB_TOKEN=

# Normal Docker seccomp blocks Chromium/Electron's inner sandbox.
# 0 uses app-specific --no-sandbox launchers, NOT privileged Docker.
# 1 removes that flag; the host must support the app sandbox in containers.
APP_SANDBOX=0

# All persistent data stays below DEVBOX_DATA_DIR.
# Enable the server with ./compose.sh --ollama up -d. Add --gpu for NVIDIA.
# To reuse an existing server, omit --ollama and set its reachable host/port.
OLLAMA_SERVER_HOST=desktop-ollama
OLLAMA_SERVER_PORT=11434
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=5m

# Must not overlap your LAN, VPN tunnel, or other Docker networks.
DESKTOP_SUBNET=10.203.86.0/24
GPU_RENDER_NODE=/dev/dri/renderD128
NVIDIA_VISIBLE_DEVICES=all

# Optional: ./compose.sh --vpn --gpu --ollama up -d
# These are NordVPN *service* credentials, not your website login.
NORDVPN_USERNAME=
NORDVPN_PASSWORD=
NORDVPN_COUNTRIES=United States
# Include DESKTOP_SUBNET. Add only explicit extra destinations if needed.
# Every allowed subnet bypasses the VPN, so do not use 0.0.0.0/0.
VPN_ALLOWED_SUBNETS=10.203.86.0/24

# Optional version pins. By default, rebuilding fetches current packages.
# COPILOT_CLI_VERSION=1.0.114
# COPILOT_APP_VERSION=1.4.2
# REA_VERSION=6.9.0
# DESKTOP_BASE=ghcr.io/linuxserver/baseimage-selkies:ubunturesolute
# NODE_IMAGE=node:26-bookworm-slim
# DOTNET_LTS_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
# DOTNET_CURRENT_IMAGE=mcr.microsoft.com/dotnet/sdk:11.0
# OLLAMA_IMAGE=ollama/ollama:latest
# GLUETUN_IMAGE=qmcgaw/gluetun:latest
