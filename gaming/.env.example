# Copy to .env, chmod 600, and set a unique password before starting.
# Use ghcr.io/long2know/gamebox:latest after pulling the public image.
GAMEBOX_IMAGE=gamebox-cinnamon:latest
# Set to public to build locally without Chrome.
GAMEBOX_BUILD_TARGET=full
GAMEBOX_USER=developer
# Single-quote passwords containing $ so Compose preserves them literally.
GAMEBOX_PASSWORD=
GAMEBOX_DATA_DIR=./data
GAMEBOX_PUID=1000
GAMEBOX_PGID=1000
GAMEBOX_TZ=America/Los_Angeles
GAMEBOX_TITLE=gamebox

# For a proxy on a different host, bind to the Gamebox host's private LAN IP
# and restrict access to the proxy. Use 0.0.0.0 only on a restricted host.
GAMEBOX_BIND_ADDRESS=127.0.0.1
GAMEBOX_PORT=4201
# 3001 = HTTPS; 3000 = HTTP only on loopback or behind an HTTPS proxy.
GAMEBOX_BACKEND_PORT=3001
# /gamebox and /gamebox/ are equivalent. Set /gaming for the gaming route.
GAMEBOX_BASE_PATH=/gamebox

# On the public image, 1 installs Chrome from Google on container startup.
GAMEBOX_INSTALL_VENDOR_APPS=0
GAMEBOX_APP_SANDBOX=0

# Edit the /games bind in compose.yaml to share an existing host library.
# GAMEBOX_GPU_RENDER_NODE=/dev/dri/renderD128
# GAMEBOX_NVIDIA_VISIBLE_DEVICES=all
