#!/usr/bin/env python3
import base64
import os
from pathlib import Path
import pwd
import socket
import subprocess
import urllib.request

if not Path("/run/dev-desktop-ready").is_file():
    raise SystemExit("Desktop initialization has not completed.")
subprocess.run(
    ["xset", "q"],
    check=True,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    timeout=3,
)
uid = str(pwd.getpwnam("abc").pw_uid)
subprocess.run(
    ["pgrep", "-u", uid, "-x", "cinnamon"],
    check=True,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
    timeout=3,
)
connection = socket.create_connection(("127.0.0.1", 8082), timeout=3)
connection.close()
credentials = f"{os.environ.get('CUSTOM_USER', 'abc')}:{os.environ['PASSWORD']}"
request = urllib.request.Request(
    f"http://127.0.0.1:3000{os.environ.get('SUBFOLDER', '/')}",
    headers={
        "Authorization": "Basic "
        + base64.b64encode(credentials.encode()).decode()
    },
)
with urllib.request.urlopen(request, timeout=5) as response:
    if response.status != 200:
        raise SystemExit(f"Unexpected desktop HTTP status: {response.status}")
