#!/usr/bin/env bash
set -euo pipefail

node --version
npm --version
dotnet --list-sdks
dotnet --list-runtimes
pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'
gh --version
copilot --version
rea --version
/usr/bin/code --version
google-chrome-stable --version
/usr/local/bin/wrapped-chromium --version
if dpkg-query -W -f='${db:Status-Status}' chromium 2>/dev/null | grep -qx installed; then
    echo "The Chromium package must not replace the official Google Chrome browser." >&2
    exit 1
fi
test -r /usr/local/share/dev-desktop/copilot-app-command.json
test -s /config/.copilot/mcp-config.json
node - <<'JS'
const fs = require('node:fs');
const config = JSON.parse(fs.readFileSync('/config/.copilot/mcp-config.json', 'utf8'));
if (!config.mcpServers?.rea) throw new Error('REA is missing from Copilot MCP configuration');
console.log('REA is registered in the persistent Copilot home');
JS
rea mcp doctor --json
desktop-media-smoke-test "$@"
if [[ "${1:-}" == --gpu ]]; then
    nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
    glxinfo -B
fi
curl --fail --silent --show-error http://127.0.0.1:11434/api/tags
printf '\n'
